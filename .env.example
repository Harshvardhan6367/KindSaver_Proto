PORT=4000
NODE_ENV=development

# memory keeps the prototype runnable without external services.
# Set this to mongodb after you have created a MongoDB Atlas cluster.
STORAGE_DRIVER=memory

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/
MONGODB_DB=kindreport_jaipur

CORS_ORIGIN=http://127.0.0.1:5173
ALLOW_DB_SEED=false
